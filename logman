#!/bin/bash

# 1. Self-elevate to root if not currently root
if [ "$EUID" -ne 0 ]; then
    echo "Root privileges are required to manage logs. Elevating..."
    exec sudo "$0" "$@"
fi

# Colors for professional output
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Helper function: Pause before returning to menu
pause() {
    echo ""
    read -n 1 -s -r -p "Press any key to return to the menu..."
}

# Helper function: Purge .gz logs
purge_gz() {
    echo -e "\n${YELLOW}Searching for old compressed (.gz) logs in /var/log/...${NC}"
    local gz_files=$(find /var/log -type f -name "*.gz")
    
    if [ -z "$gz_files" ]; then
        echo -e "${GREEN}[+] No .gz log files found to purge.${NC}"
    else
        echo "$gz_files"
        echo ""
        read -n 1 -p "Are you sure you want to permanently delete these files? (y/N): " confirm
        echo ""
        if [[ "${confirm,,}" == "y" ]]; then
            find /var/log -type f -name "*.gz" -delete
            echo -e "${GREEN}[+] All .gz logs have been successfully purged.${NC}"
        else
            echo -e "${YELLOW}[-] Purge canceled.${NC}"
        fi
    fi
    pause
}

# Helper function: Truncate all logs and purge rotated logs
purge_all() {
    echo -e "\n${YELLOW}WARNING: This will truncate all .log files (except postgresql-17-main.log)${NC}"
    echo -e "${YELLOW}and permanently delete all .gz, .xz, and .[0-9] log files.${NC}"
    echo ""
    read -n 1 -p "Are you sure you want to proceed? (y/N): " confirm
    echo ""
    if [[ "${confirm,,}" == "y" ]]; then
        echo -e "${CYAN}Executing...${NC}"
        find /var/log -type f -name "*.log" ! -path "/var/log/postgresql/postgresql-17-main.log" -exec truncate -s 0 {} + && find /var/log -type f -regex ".*\.gz$\|.*\.xz$\|.*\.[0-9]$" -delete
        echo -e "${GREEN}[+] Operation complete. Logs truncated and old archives deleted.${NC}"
    else
        echo -e "${YELLOW}[-] Operation canceled.${NC}"
    fi
    pause
}

# Helper function: Wipe bash history for the current user
wipe_user_history() {
    echo -e "\n${YELLOW}WARNING: This will permanently delete the bash history file for the current user.${NC}"
    echo ""
    read -n 1 -p "Are you sure you want to proceed? (y/N): " confirm
    echo ""
    if [[ "${confirm,,}" == "y" ]]; then
        # Check if running via sudo to target the original user instead of root
        if [ -n "$SUDO_USER" ]; then
            USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
            > "$USER_HOME/.bash_history"
            echo -e "${GREEN}[+] Bash history wiped for user: $SUDO_USER${NC}"
        else
            > ~/.bash_history
            echo -e "${GREEN}[+] Bash history wiped for root${NC}"
        fi
        echo -e "${YELLOW}[!] Note: You may also need to run 'history -c' in your terminal after exiting to clear the current session's memory cache.${NC}"
    else
        echo -e "${YELLOW}[-] Operation canceled.${NC}"
    fi
    pause
}

# Main Application Loop
while true; do
    clear
    echo -e "${CYAN}===============================================================================${NC}"
    echo -e "${CYAN}                            SYSTEM LOG MANAGER                                 ${NC}"
    echo -e "${CYAN}===============================================================================${NC}"
    echo ""
    
    # Fetch all standard files in /var/log, excluding compressed archives
    # Sort them alphabetically for easier reading
    mapfile -t LOGS < <(find /var/log -maxdepth 2 -type f ! -name "*.gz" ! -name "*.1" | sort)

    if [ ${#LOGS[@]} -eq 0 ]; then
        echo -e "${RED}[!] No logs found in /var/log/${NC}"
        exit 1
    fi

    # Display in an organized 2-column grid (Top-to-Bottom, Left-to-Right)
    num_logs=${#LOGS[@]}
    num_rows=$(( (num_logs + 1) / 2 ))
    
    for (( r=0; r<num_rows; r++ )); do
        for (( c=0; c<2; c++ )); do
            i=$(( r + c * num_rows ))
            if [ $i -lt $num_logs ]; then
                base_name="${LOGS[$i]##*/}"
                display_name="${base_name%.log}"
                printf "${YELLOW}%3d)${NC} %-40.40s " "$((i+1))" "$display_name"
            fi
        done
        echo ""
    done
    
    echo ""
    echo -e "${CYAN}===============================================================================${NC}"
    echo -e "  ${YELLOW}p)${NC} Purge old .gz logs"
    echo -e "  ${YELLOW}a)${NC} Truncate all .log files and delete rotated archives"
    echo -e "  ${YELLOW}h)${NC} Wipe bash history for current user"
    echo -e "  ${YELLOW}q)${NC} Quit"
    echo ""
    
    # Prompt for selection
    read -p "Select a log number or action: " selection
    
    # Handle global actions
    if [[ "${selection,,}" == "q" ]]; then
        echo ""
        exit 0
    elif [[ "${selection,,}" == "p" ]]; then
        purge_gz
        continue
    elif [[ "${selection,,}" == "a" ]]; then
        purge_all
        continue
    elif [[ "${selection,,}" == "h" ]]; then
        wipe_user_history
        continue
    fi

    # Validate log selection input
    if [[ ! "$selection" =~ ^[0-9]+$ ]] || [ "$selection" -lt 1 ] || [ "$selection" -gt "${#LOGS[@]}" ]; then
        echo -e "\n${RED}[!] Invalid selection.${NC}"
        pause
        continue
    fi

    # Map input back to the array (0-indexed)
    TARGET_LOG="${LOGS[$((selection-1))]}"
    
    # Secondary Menu for the selected log
    echo -e "\n${CYAN}--- Target: $TARGET_LOG ---${NC}"
    echo "  f) View FULL log"
    echo "  t) TAIL specific number of lines"
    echo "  c) CLEAR / Truncate log to 0 bytes"
    echo "  b) Back to main menu"
    echo ""
    
    read -n 1 -p "Select action: " action
    echo ""
    
    case "${action,,}" in
        f)
            echo -e "\nOpening $TARGET_LOG (Press 'q' to exit viewer)..."
            sleep 1
            less "$TARGET_LOG"
            ;;
        t)
            echo ""
            read -p "How many lines would you like to view? (Default 50): " lines
            lines=${lines:-50}
            echo -e "\n${YELLOW}--- Last $lines lines of $TARGET_LOG ---${NC}"
            tail -n "$lines" "$TARGET_LOG"
            pause
            ;;
        c)
            echo ""
            read -n 1 -p "WARNING: This will permanently empty $TARGET_LOG. Continue? (y/N): " confirm
            echo ""
            if [[ "${confirm,,}" == "y" ]]; then
                truncate -s 0 "$TARGET_LOG"
                echo -e "${GREEN}[+] Log truncated successfully.${NC}"
            else
                echo -e "${YELLOW}[-] Truncation canceled.${NC}"
            fi
            pause
            ;;
        b)
            continue
            ;;
        *)
            echo -e "${RED}[!] Invalid action.${NC}"
            pause
            ;;
    esac
done
